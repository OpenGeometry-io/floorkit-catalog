  "metadata": {
    "catalog:version": "1.0.0",
    "catalog:license": "CC-BY-4.0",
    "catalog:attribution": "Vishwajeet Mane",
    "catalog:category": "sanitary",
    "catalog:placement": "free",
    "catalog:lod": "300",
    "catalog:tags": "shower, level access, accessible, wet room, bathroom",
    "catalog:note": "Level-access shower: a wet area 1.20 x 1.20 with a floor finish 0.010 thick and a square gully flush in it, a fold-down seat on two brackets at seat 0.48, a valve, a riser rail to 2.00 (the overall height) and a handset on the back wall (wallFace). The seat is 0.45 x 0.40. Rail and handset build as prisms. Seat and fittings sit off the centreline: a mirrored copy keeps the anchors and ports where they are.",
    "catalog:basedOn": "BS 8300-2 and Approved Document M (wet area 1.20 x 1.20, seat 0.48), not read, unverified; ports BS EN 12056-2 via the drafting standard, not read, unverified; height 2.00 and seat 0.45 x 0.40 practice sizes, unverified",
    "ifc:class": "IfcSanitaryTerminal",
    "ifc:predefinedType": "SHOWER",
    "ifcClass": "IfcSanitaryTerminal",
    "mat:gully": "metal",
    "mat:seat": "surface",
    "mat:valve": "metal",
    "mat:riser-rail": "metal",
    "mat:handset": "metal",
    "mat:floorSlab": "ceramic",
    "mat:bracket": "frame"
  },
