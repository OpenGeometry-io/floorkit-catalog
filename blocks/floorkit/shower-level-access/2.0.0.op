{
  "version": 1,
  "id": "floorkit.shower-level-access",
  "labelName": "Level-Access Shower",
  "type": "FIXTURE",
  "dimensions": {
    "width": 1.2,
    "depth": 1.2,
    "height": 2.01
  },
  "metadata": {
    "catalog:version": "2.0.0",
    "catalog:license": "CC-BY-4.0",
    "catalog:attribution": "Vishwajeet Mane",
    "catalog:category": "sanitary",
    "catalog:placement": "free",
    "catalog:lod": "300",
    "catalog:format": "2",
    "catalog:tags": "shower, level access, accessible, wet room, bathroom",
    "catalog:note": "Level-access shower: a wet area 1.20 x 1.20; its floor finish, 0.010 thick, is let into the floor (recess), face level with the room floor, and a square gully lies flush in a cut through it; falls in plan only. A fold-down seat, 0.45 x 0.40 with rounded front corners, on two brackets, seat 0.48; a valve centred 0.90 above the floor; a riser rail to 2.00 and a handset on the back wall (wallFace). Rail and handset build as prisms. A mirrored copy keeps the off-centre anchors and ports in place.",
    "catalog:basedOn": "Approved Document M Vol 2 (2015, 2024 amendments, GOV.UK) 5.18(q): shower controls 750 to 1000mm above the floor (said of communal areas), valve centred 0.90; wet area 1.20 x 1.20 and seat 0.48 (BS 8300-2, not read) and other sizes practice, unverified; ports BS EN 12056-2 via the standard, not read",
    "ifc:class": "IfcSanitaryTerminal",
    "ifc:predefinedType": "SHOWER",
    "ifcClass": "IfcSanitaryTerminal",
    "mat:gully": "metal",
    "mat:seat": "surface",
    "mat:valve": "metal",
    "mat:riser-rail": "metal",
    "mat:handset": "metal",
    "mat:floorSlab": "ceramic",
    "mat:bracket": "frame"
  },
