  "metadata": {
    "catalog:version": "1.0.0",
    "catalog:license": "CC-BY-4.0",
    "catalog:attribution": "Vishwajeet Mane",
    "catalog:category": "sanitary",
    "catalog:placement": "free",
    "catalog:lod": "300",
    "catalog:format": "2",
    "catalog:tags": "shower, shower enclosure, quadrant, bathroom",
    "catalog:note": "Quadrant shower enclosure on a tray: rim 0.04. The back wall is on wallFace and the left side (-x) is a wall too; mirror the block for the other hand. Tray: one flat quadrant slab of radius 0.90, 0.04 high all round, sealed to the walls, the gully flush in a hole through it; its falls are drawn in plan only. Curved glass 0.010 on the slab: two fixed panels and a sliding door 0.002 inside them. A riser on the valve carries the head.",
    "catalog:basedOn": "Drafting standard key dimensions (practice, verify; EN 14527 for the tray), not read, unverified; quadrant of radius 0.90 filling the 0.90 x 0.90 footprint, generic, unverified; ports BS EN 12056-2 via the drafting standard, not read, unverified; height 2.00 practice size, unverified",
    "ifc:class": "IfcSanitaryTerminal",
    "ifc:predefinedType": "SHOWER",
    "ifcClass": "IfcSanitaryTerminal",
