  "metadata": {
    "catalog:version": "2.0.0",
    "catalog:license": "CC-BY-4.0",
    "catalog:attribution": "Vishwajeet Mane",
    "catalog:category": "sanitary",
    "catalog:placement": "free",
    "catalog:lod": "300",
    "catalog:format": "2",
    "catalog:tags": "wc, toilet, accessible, wheelchair, bathroom",
    "catalog:note": "Accessible close-coupled WC in format v2, a seat and no lid: seat 0.48, rim 0.46, pan front 0.75 from the wall. The pan is an oval of true arcs with a round bowl, two outline sweeps from the wall, on a bowl floor and a foot of the same oval set 0.07 in. The seat is an oval ring on the rim, hinged on a bar behind it. The transfer side and the lever flush are at +x; a mirrored copy keeps flushSide at +x, so mirror it with care. Grab rails are not drawn.",
    "catalog:basedOn": "Approved Document M and BS 8300-2 via the drafting standard key dimensions: seat 0.48, pan front 0.75 from the wall, from secondary summaries, not the documents; width 0.38 practice, unverified. The oval is the author's. Port sizes from the drafting standard (BS EN 12056-2 conventions), unverified",
    "ifc:class": "IfcSanitaryTerminal",
    "ifc:predefinedType": "TOILETPAN",
    "ifcClass": "IfcSanitaryTerminal",
