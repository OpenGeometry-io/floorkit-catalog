{
  "version": 1,
  "id": "floorkit.wc-accessible",
  "labelName": "Accessible WC",
  "type": "FIXTURE",
  "dimensions": {
    "width": 0.38,
    "depth": 0.75,
    "height": 0.8
  },
  "metadata": {
    "catalog:version": "1.0.0",
    "catalog:license": "CC-BY-4.0",
    "catalog:attribution": "Vishwajeet Mane",
    "catalog:category": "sanitary",
    "catalog:placement": "free",
    "catalog:lod": "300",
    "catalog:tags": "wc, toilet, accessible, wheelchair, bathroom",
    "catalog:note": "Accessible close-coupled WC with a seat and no lid: seat 0.48, rim 0.46, pan front 0.75 from the wall. The pan is a D of radius 0.19 with a round bowl, drawn as two straight sweeps from the wall, on a bowl floor and a foot with a rounded front. The seat is a D ring on the rim, hinged on a bar behind it. The transfer side and the lever flush are at +x; a mirrored copy keeps flushSide at +x, so mirror it with care. Grab rails are not drawn.",
    "catalog:basedOn": "Approved Document M and BS 8300-2 via the drafting standard key dimensions: seat 0.48, pan front 0.75 from the wall, from secondary summaries, not the documents; width 0.38 practice, unverified. Port sizes from the drafting standard (BS EN 12056-2 conventions), unverified",
    "ifc:class": "IfcSanitaryTerminal",
    "ifc:predefinedType": "TOILETPAN",
    "ifcClass": "IfcSanitaryTerminal",
    "mat:foot": "ceramic",
    "mat:bowlFloor": "ceramic",
    "mat:panLeft": "ceramic",
    "mat:panRight": "ceramic",
    "mat:seatLeft": "surface",
    "mat:seatRight": "surface",
    "mat:seatHinge": "metal",
    "mat:cistern": "ceramic",
    "mat:flushLever": "metal"
  },
